local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local LocalPlayer = Players.LocalPlayer

local PlaceId = game.PlaceId
local JobId = game.JobId

local Lobby = workspace:WaitForChild("Lobby")
local TeleportPart = Lobby:WaitForChild("Teleport1")

local Arena = workspace:WaitForChild("Arena")
local Island = Arena:WaitForChild("island5")
local Slapples = Island:WaitForChild("Slapples")

local RawFile = "https://raw.githubusercontent.com/Roomy91827/slapple-farm/refs/heads/main/Client"
local FileName = "SlappleFarm.lua"


local function SaveScript()
		local Source = game:HttpGet(RawFile)
		writefile(FileName, Source)
	end
	
	local function QueueReexecute()
		if type(queue_on_teleport) == "function" then
			queue_on_teleport([[
		            if isfile("SlappleFarm.lua") then
		                loadstring(readfile("SlappleFarm.lua"))()
		            end
		        ]])
		end
